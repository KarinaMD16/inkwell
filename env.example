# Copia este archivo como .env.local y completa los valores.

# Supabase > Project Settings > API: Project URL y la llave "publishable" (sb_publishable_...).
# Las dos son públicas: viajan al navegador. Nunca pongas aquí la llave secreta.
NEXT_PUBLIC_SUPABASE_URL=https://TU-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL de la API de Inkwell (inkwell-backend).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Client ID del cliente OAuth de Google (público; el secreto nunca va aquí). El mismo que usa Supabase.
# En Google Cloud, ese cliente debe tener el dominio del sitio en "Orígenes de JavaScript autorizados".
# Si se deja vacío, "Continuar con Google" usa la redirección a través de supabase.co.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
